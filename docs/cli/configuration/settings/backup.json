{
  "schema_version": 1,
  "entries": [
    {
      "key": "backup.scope",
      "type": "enum",
      "default": "affected",
      "constraints": {
        "values": [
          "affected",
          "collection"
        ]
      },
      "scope": "global",
      "consumer": "ALG-BACKUP",
      "description": "Schema migration escalates coverage regardless of preference.",
      "sensitive": false
    },
    {
      "key": "backup.reuse_max_age_seconds",
      "type": "integer",
      "default": 0,
      "constraints": {
        "min": 0,
        "max": 3600
      },
      "scope": "global",
      "consumer": "ALG-BACKUP",
      "description": "Zero creates a fresh checkpoint; unchanged manifests still required.",
      "sensitive": false
    },
    {
      "key": "backup.verify_timeout_seconds",
      "type": "integer",
      "default": 120,
      "constraints": {
        "min": 10,
        "max": 3600
      },
      "scope": "global",
      "consumer": "ALG-BACKUP",
      "description": "Package verification deadline.",
      "sensitive": false
    },
    {
      "key": "backup.max_package_gb",
      "type": "integer",
      "default": 64,
      "constraints": { "min": 1, "max": 1024 },
      "scope": "global",
      "consumer": "ALG-BACKUP",
      "description": "Maximum collection package file size accepted by read-only inspection.",
      "sensitive": false
    },
    {
      "key": "backup.max_collection_gb",
      "type": "integer",
      "default": 64,
      "constraints": { "min": 1, "max": 1024 },
      "scope": "global",
      "consumer": "ALG-BACKUP",
      "description": "Maximum decoded collection bytes accepted from a package.",
      "sensitive": false
    },
    {
      "key": "backup.max_media_gb",
      "type": "integer",
      "default": 64,
      "constraints": { "min": 1, "max": 1024 },
      "scope": "global",
      "consumer": "ALG-BACKUP",
      "description": "Maximum aggregate decoded media bytes accepted from a package.",
      "sensitive": false
    },
    {
      "key": "backup.max_media_map_mb",
      "type": "integer",
      "default": 64,
      "constraints": { "min": 1, "max": 1024 },
      "scope": "global",
      "consumer": "ALG-BACKUP",
      "description": "Maximum decoded media index bytes accepted from a package.",
      "sensitive": false
    },
    {
      "key": "backup.max_entries",
      "type": "integer",
      "default": 100000,
      "constraints": { "min": 4, "max": 1000000 },
      "scope": "global",
      "consumer": "ALG-BACKUP",
      "description": "Maximum ZIP entries accepted by package inspection.",
      "sensitive": false
    },
    {
      "key": "backup.verify_scratch_dir",
      "type": "string",
      "default": "/tmp",
      "constraints": { "format": "path" },
      "scope": "global",
      "consumer": "ALG-BACKUP",
      "description": "Existing directory for private, automatically removed decoded collection files during package inspection.",
      "sensitive": false
    }
  ]
}
