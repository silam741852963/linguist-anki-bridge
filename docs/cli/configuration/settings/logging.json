{
  "schema_version": 1,
  "entries": [
    {
      "key": "logging.level",
      "type": "enum",
      "default": "info",
      "constraints": {
        "values": [
          "error",
          "warn",
          "info",
          "debug",
          "trace"
        ]
      },
      "scope": "global",
      "consumer": "logging",
      "description": "Default private payload redaction at every level.",
      "sensitive": false
    },
    {
      "key": "logging.file_enabled",
      "type": "boolean",
      "default": true,
      "constraints": {},
      "scope": "global",
      "consumer": "logging",
      "description": "Private local structured diagnostic file.",
      "sensitive": false
    },
    {
      "key": "logging.max_file_mb",
      "type": "integer",
      "default": 20,
      "constraints": {
        "min": 1,
        "max": 1000
      },
      "scope": "global",
      "consumer": "logging",
      "description": "Rotation size.",
      "sensitive": false
    },
    {
      "key": "logging.retained_files",
      "type": "integer",
      "default": 5,
      "constraints": {
        "min": 1,
        "max": 100
      },
      "scope": "global",
      "consumer": "logging",
      "description": "Diagnostic rotation count, not recovery-history retention.",
      "sensitive": false
    },
    {
      "key": "logging.include_private_payloads",
      "type": "boolean",
      "default": false,
      "constraints": {},
      "scope": "global",
      "consumer": "logging",
      "description": "Explicit local debugging opt-in; never emits secrets.",
      "sensitive": false
    }
  ]
}
