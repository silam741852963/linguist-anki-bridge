{
  "schema_version": 1,
  "entries": [
    {
      "key": "llm.endpoint",
      "type": "string",
      "default": "http://127.0.0.1:11434",
      "constraints": {
        "format": "url"
      },
      "scope": "purpose",
      "consumer": "Ollama adapter",
      "description": "Local Ollama default.",
      "sensitive": false
    },
    {
      "key": "llm.model",
      "type": "string|null",
      "default": "gemma4:12b",
      "constraints": {
        "format": "nonempty"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Selected baseline candidate; require installed capability/digest, never pull or silently substitute.",
      "sensitive": false
    },
    {
      "key": "llm.vision_model",
      "type": "string|null",
      "default": null,
      "constraints": {
        "format": "nonempty"
      },
      "scope": "purpose",
      "consumer": "vision",
      "description": "Explicit installed model with vision capability.",
      "sensitive": false
    },
    {
      "key": "llm.api_key_env",
      "type": "string|null",
      "default": null,
      "constraints": {
        "format": "env_name"
      },
      "scope": "purpose",
      "consumer": "Ollama adapter",
      "description": "Credential environment reference.",
      "sensitive": false
    },
    {
      "key": "llm.timeout_seconds",
      "type": "integer",
      "default": 180,
      "constraints": {
        "min": 10,
        "max": 1800
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Generation deadline.",
      "sensitive": false
    },
    {
      "key": "llm.temperature",
      "type": "number",
      "default": 0.0,
      "constraints": {
        "min": 0,
        "max": 2
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Provider must advertise support; preserve resolved parameter.",
      "sensitive": false
    },
    {
      "key": "llm.context_tokens",
      "type": "integer",
      "default": 16384,
      "constraints": {
        "min": 512,
        "max": 131072
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Context window sent as num_ctx. 16384 fits the longest dictionary inputs (14-sense words); gemma4:12b uses about 8.0 GB of VRAM at 16k (7.99 GB at 8k, 8.03 GB at 32k, measured on a 16 GB RTX 3080 Ti). Changing it changes the engine identity: run doctor --ollama --certify again.",
      "sensitive": false
    },
    {
      "key": "llm.max_output_tokens",
      "type": "integer",
      "default": 2048,
      "constraints": {
        "min": 128,
        "max": 32768
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Must fit context with input.",
      "sensitive": false
    },
    {
      "key": "llm.seed",
      "type": "integer",
      "default": 0,
      "constraints": {
        "min": 0,
        "max": 2147483647
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Best effort reproducibility, not a deterministic guarantee.",
      "sensitive": false
    },
    {
      "key": "llm.keep_alive",
      "type": "string",
      "default": "5m",
      "constraints": {
        "format": "duration"
      },
      "scope": "purpose",
      "consumer": "Ollama adapter",
      "description": "Validated provider duration.",
      "sensitive": false
    },
    {
      "key": "llm.prompts.vocabulary",
      "type": "string",
      "default": "builtin:vocabulary-v3",
      "constraints": {
        "format": "resource_ref"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Versioned builtin or pinned file path; trusted user instruction resource.",
      "sensitive": false
    },
    {
      "key": "llm.prompts.grammar",
      "type": "string",
      "default": "builtin:grammar-v3",
      "constraints": {
        "format": "resource_ref"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Versioned builtin or pinned file path; trusted user instruction resource.",
      "sensitive": false
    },
    {
      "key": "llm.prompts.kanji",
      "type": "string",
      "default": "builtin:kanji-v2",
      "constraints": {
        "format": "resource_ref"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Versioned builtin or pinned file path; trusted user instruction resource.",
      "sensitive": false
    },
    {
      "key": "llm.repair_attempts",
      "type": "integer",
      "default": 2,
      "constraints": {
        "min": 0,
        "max": 3
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Structural output repairs inside the shared read attempt budget; no factual fabrication.",
      "sensitive": false
    },
    {
      "key": "llm.enabled",
      "type": "boolean",
      "default": true,
      "constraints": {},
      "scope": "purpose",
      "consumer": "generation",
      "description": "Enable requested generated annotations; false uses source/dictionary/authored material only.",
      "sensitive": false
    },
    {
      "key": "llm.provider",
      "type": "enum",
      "default": "ollama",
      "constraints": {
        "values": [
          "ollama",
          "claude_code",
          "codex",
          "openai_compatible"
        ]
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Generation provider tried first: local Ollama, a command-line agent (Claude Code `claude -p`, Codex `codex exec`) or an OpenAI-compatible chat API (llm.api.*). Drafts from anything but a certified Ollama engine carry GENERATION_ENGINE_EXTERNAL.",
      "sensitive": false
    },
    {
      "key": "llm.fallback",
      "type": "string[]",
      "default": [
        "claude_code",
        "codex"
      ],
      "constraints": {
        "unique": true,
        "items_values": [
          "ollama",
          "claude_code",
          "codex",
          "openai_compatible"
        ]
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Providers tried in order when the first one fails (model error, cut-off or invalid output). An agent that is not installed, or an API without llm.api.endpoint, is skipped.",
      "sensitive": false
    },
    {
      "key": "llm.agents.timeout_seconds",
      "type": "integer",
      "default": 600,
      "constraints": {
        "min": 30,
        "max": 3600
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Deadline for one agent or API generation.",
      "sensitive": false
    },
    {
      "key": "llm.agents.claude_code.executable",
      "type": "string",
      "default": "claude",
      "constraints": {
        "format": "executable"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Claude Code executable (name looked up on PATH, or an absolute path); run as `claude -p` with no tools and a JSON schema.",
      "sensitive": false
    },
    {
      "key": "llm.agents.claude_code.model",
      "type": "string|null",
      "default": null,
      "constraints": {
        "format": "nonempty"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Model for Claude Code (--model); null uses its default.",
      "sensitive": false
    },
    {
      "key": "llm.agents.codex.executable",
      "type": "string",
      "default": "codex",
      "constraints": {
        "format": "executable"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Codex CLI executable; run as `codex exec` in a read-only sandbox with an output schema.",
      "sensitive": false
    },
    {
      "key": "llm.agents.codex.model",
      "type": "string|null",
      "default": null,
      "constraints": {
        "format": "nonempty"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Model for Codex (-m); null uses its default.",
      "sensitive": false
    },
    {
      "key": "llm.api.endpoint",
      "type": "string|null",
      "default": null,
      "constraints": {
        "format": "url"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "OpenAI-compatible base URL (for example https://api.openai.com/v1 or https://openrouter.ai/api/v1); /chat/completions is appended.",
      "sensitive": false
    },
    {
      "key": "llm.api.model",
      "type": "string|null",
      "default": null,
      "constraints": {
        "format": "nonempty"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Model name for the OpenAI-compatible API.",
      "sensitive": false
    },
    {
      "key": "llm.api.api_key_env",
      "type": "string|null",
      "default": null,
      "constraints": {
        "format": "env_name"
      },
      "scope": "purpose",
      "consumer": "generation",
      "description": "Environment variable holding the API key (sent as a Bearer token).",
      "sensitive": false
    }
  ]
}
