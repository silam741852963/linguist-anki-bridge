# Maintainer: Lam <lam@example.com>
pkgname=linguist-anki-bridge-native-git
_pkgname=linguist-anki-bridge
pkgver=0.0.1
pkgrel=1
pkgdesc="Native Qt preview for Linguist Anki Bridge"
arch=('x86_64')
url="https://github.com/silam741852963/linguist-anki-bridge"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'tesseract')
makedepends=('cargo' 'clang' 'cmake' 'git' 'qt6-declarative')
provides=('linguist-anki-bridge-native')
source=("git+$url.git")
md5sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g' || echo "0.0.1"
}

build() {
    cd "$srcdir/$_pkgname"
    cargo build --release --locked -p linguist-desktop
}

package() {
    cd "$srcdir/$_pkgname"
    install -Dm755 target/release/linguist-anki-bridge-native "$pkgdir/usr/bin/linguist-anki-bridge-native"
    install -Dm644 docs/native-preview-release.md "$pkgdir/usr/share/doc/$pkgname/native-preview-release.md"
}
