{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningDocument",
  "type": "object",
  "properties": {
    "archives": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceArchive"
      }
    },
    "content": {
      "$ref": "#/$defs/LearningContent"
    },
    "context": {
      "type": "string",
      "default": ""
    },
    "edits": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/FieldIntent"
      },
      "default": {}
    },
    "evidence": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "explanation_language": {
      "$ref": "#/$defs/Language"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "issues": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Issue"
      }
    },
    "media": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/MediaAsset"
      }
    },
    "personal_notes": {
      "type": "string",
      "default": ""
    },
    "regions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRegion"
      }
    },
    "requested_tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Task"
      }
    },
    "reviews": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewDecision"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 2,
      "minimum": 2
    },
    "source_summary": {
      "type": "string",
      "default": ""
    },
    "sources": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRecord"
      }
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "target_language": {
      "$ref": "#/$defs/Language"
    },
    "task_maps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceTaskMap"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "target_language",
    "explanation_language",
    "content",
    "requested_tasks"
  ],
  "$defs": {
    "AnkiId": {
      "description": "Canonical positive decimal Anki ID, at most 9007199254740991",
      "type": "string",
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)$"
    },
    "CardState": {
      "type": "object",
      "properties": {
        "deck_id": {
          "$ref": "#/$defs/AnkiId"
        },
        "history_digest": {
          "type": "string"
        },
        "home_deck_id": {
          "$ref": "#/$defs/AnkiId"
        },
        "id": {
          "$ref": "#/$defs/AnkiId"
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "task": {
          "$ref": "#/$defs/Task"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "task",
        "deck_id",
        "home_deck_id",
        "scheduler",
        "history_digest"
      ]
    },
    "Collocation": {
      "type": "object",
      "properties": {
        "gloss": {
          "type": "string"
        },
        "phrase": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "phrase",
        "gloss"
      ]
    },
    "Contrast": {
      "type": "object",
      "properties": {
        "difference": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "expression",
        "difference"
      ]
    },
    "DictionaryEntry": {
      "type": "object",
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        },
        "provider": {
          "type": "string"
        },
        "readings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_entries": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "senses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sense"
          }
        },
        "source_url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "source_url",
        "language",
        "forms",
        "readings",
        "senses"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "ambiguous": {
          "type": "boolean"
        },
        "claim": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "region_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceTextSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "field",
        "provenance",
        "language",
        "claim",
        "ambiguous"
      ]
    },
    "EvidenceTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entry_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "dictionary_sense"
            },
            "sense_index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "entry_index",
            "sense_index"
          ]
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "example"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "grammar_formation"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "media_asset"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "digest"
          ]
        }
      ]
    },
    "Example": {
      "type": "object",
      "properties": {
        "evidence_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "sentence": {
          "type": "string"
        },
        "translation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sentence",
        "translation",
        "provenance"
      ]
    },
    "FieldIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "const": "keep"
            }
          },
          "additionalProperties": false,
          "required": [
            "intent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "const": "set"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "intent",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "const": "clear"
            }
          },
          "additionalProperties": false,
          "required": [
            "intent"
          ]
        }
      ]
    },
    "Grammar": {
      "type": "object",
      "properties": {
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Example"
          }
        },
        "exercise_answer": {
          "type": "string",
          "default": ""
        },
        "exercise_prompt": {
          "type": "string",
          "default": ""
        },
        "formation": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "recognition_prompt": {
          "type": "string"
        },
        "usage": {
          "type": "string",
          "default": ""
        },
        "use_key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "pattern",
        "use_key",
        "meaning",
        "formation",
        "recognition_prompt",
        "examples"
      ]
    },
    "Issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "severity",
        "stage",
        "source_refs",
        "message"
      ]
    },
    "KanjiDetail": {
      "type": "object",
      "properties": {
        "character": {
          "type": "string"
        },
        "jlpt": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "kun_readings": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "meanings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_readings": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "parts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "radical": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "stroke_digest": {
          "description": "Digest of the `kanji_stroke` media asset animating this character, if any.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "strokes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "character",
        "meanings"
      ]
    },
    "Language": {
      "type": "string"
    },
    "LearningContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "body": {
              "$ref": "#/$defs/Vocabulary"
            },
            "kind": {
              "type": "string",
              "const": "vocabulary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "body": {
              "$ref": "#/$defs/Grammar"
            },
            "kind": {
              "type": "string",
              "const": "grammar"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "body"
          ]
        }
      ]
    },
    "MediaAsset": {
      "type": "object",
      "properties": {
        "attribution": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime": {
          "type": "string"
        },
        "original_filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "$ref": "#/$defs/MediaOwner"
        },
        "role": {
          "$ref": "#/$defs/MediaRole"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "filename",
        "size_bytes",
        "mime",
        "owner",
        "role",
        "attribution"
      ]
    },
    "MediaOwner": {
      "type": "string",
      "enum": [
        "source",
        "app",
        "external"
      ]
    },
    "MediaRole": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "picture",
            "audio",
            "archive"
          ]
        },
        {
          "description": "Animated stroke-order image for one kanji (v3 Kanji field).",
          "type": "string",
          "const": "kanji_stroke"
        }
      ]
    },
    "NativeCardEvidence": {
      "description": "One source card as observed through `labInspect` note evidence.",
      "type": "object",
      "properties": {
        "card_id": {
          "$ref": "#/$defs/AnkiId"
        },
        "deck_id": {
          "$ref": "#/$defs/AnkiId"
        },
        "history_digest": {
          "description": "SHA-256 of the card's canonical review rows.",
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "repetitions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "review_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "card_id",
        "ordinal",
        "deck_id",
        "repetitions",
        "review_count",
        "history_digest"
      ]
    },
    "Provenance": {
      "type": "string",
      "enum": [
        "source",
        "dictionary",
        "ocr",
        "generated",
        "user",
        "provider"
      ]
    },
    "ReviewChoice": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "sense"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "sense_with_reading"
            },
            "value": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "reading": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "key",
                "reading"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "anchor"
            },
            "value": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "segmentation"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "duplicate"
            },
            "value": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "note_id": {
                  "$ref": "#/$defs/AnkiId"
                }
              },
              "additionalProperties": false,
              "required": [
                "note_id",
                "action"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "media"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "expression"
            },
            "value": {
              "type": "object",
              "properties": {
                "region_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "additionalProperties": false,
              "required": [
                "region_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "cue"
            },
            "value": {
              "type": "object",
              "properties": {
                "task": {
                  "$ref": "#/$defs/Task"
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "task",
                "text"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "exercise"
            },
            "value": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "prompt",
                "answer"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "content_verified"
            },
            "value": {
              "type": "object",
              "properties": {
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "evidence_ids"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "source_content_verified"
            },
            "value": {
              "type": "object",
              "properties": {
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "source_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "additionalProperties": false,
              "required": [
                "source_id",
                "evidence_ids"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "source_media_role"
            },
            "value": {
              "type": "object",
              "properties": {
                "asset_digest": {
                  "type": "string"
                },
                "attribution": {
                  "type": "string"
                },
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "license": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "original_filename": {
                  "type": "string"
                },
                "role": {
                  "$ref": "#/$defs/MediaRole"
                },
                "source_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "additionalProperties": false,
              "required": [
                "source_id",
                "asset_digest",
                "original_filename",
                "evidence_id",
                "role",
