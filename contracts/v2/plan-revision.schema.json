              "additionalProperties": false,
              "required": [
                "note_id",
                "action"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "media"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "cue"
            },
            "value": {
              "type": "object",
              "properties": {
                "task": {
                  "$ref": "#/$defs/Task"
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "task",
                "text"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "content_verified"
            },
            "value": {
              "type": "object",
              "properties": {
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "evidence_ids"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "source_content_verified"
            },
            "value": {
              "type": "object",
              "properties": {
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "source_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "additionalProperties": false,
              "required": [
                "source_id",
                "evidence_ids"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "source_media_role"
            },
            "value": {
              "type": "object",
              "properties": {
                "asset_digest": {
                  "type": "string"
                },
                "attribution": {
                  "type": "string"
                },
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "license": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "original_filename": {
                  "type": "string"
                },
                "role": {
                  "$ref": "#/$defs/MediaRole"
                },
                "source_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "additionalProperties": false,
              "required": [
                "source_id",
                "asset_digest",
                "original_filename",
                "evidence_id",
                "role",
                "attribution"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        }
      ]
