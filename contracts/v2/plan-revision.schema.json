          "type": "string"
        },
        "choice": {
          "$ref": "#/$defs/ReviewChoice"
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "input_digest": {
          "type": "string"
        },
        "issue_id": {
          "type": "string"
