    "Issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "severity",
        "stage",
        "source_refs",
        "message"
      ]
    },
    "Language": {
      "type": "string"
    },
    "LearningContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "body": {
              "$ref": "#/$defs/Vocabulary"
            },
            "kind": {
              "type": "string",
              "const": "vocabulary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "body": {
              "$ref": "#/$defs/Grammar"
            },
            "kind": {
              "type": "string",
              "const": "grammar"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "body"
          ]
        }
      ]
    },
    "LearningDocument": {
      "type": "object",
      "properties": {
        "archives": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceArchive"
          }
        },
        "content": {
          "$ref": "#/$defs/LearningContent"
        },
        "context": {
          "type": "string",
          "default": ""
        },
        "edits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldIntent"
