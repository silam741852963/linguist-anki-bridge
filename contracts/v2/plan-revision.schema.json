            "kind": {
              "type": "string",
              "const": "note_ids"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input"
          ]
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "query"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input"
          ]
        },
        {
          "type": "object",
