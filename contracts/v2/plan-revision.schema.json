{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanRevision",
  "type": "object",
  "properties": {
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/CollectionBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LearningDocument"
      }
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "rendered": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RenderedNote"
      }
    },
    "review_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReviewDecision"
      }
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectionReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "$ref": "#/$defs/ResolvedSettings"
    },
    "source_digest": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "settings",
    "source_digest",
    "documents",
    "rendered",
    "review_decisions"
  ],
  "$defs": {
