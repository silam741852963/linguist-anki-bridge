    "Evidence": {
      "type": "object",
      "properties": {
        "ambiguous": {
          "type": "boolean"
        },
        "claim": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "region_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "field",
        "provenance",
        "language",
        "claim",
        "ambiguous"
      ]
    },
    "Example": {
      "type": "object",
      "properties": {
        "evidence_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "sentence": {
          "type": "string"
        },
        "translation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sentence",
        "translation",
        "provenance"
      ]
    },
    "FieldIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "const": "keep"
            }
          },
          "additionalProperties": false,
          "required": [
            "intent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "const": "set"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "intent",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "const": "clear"
            }
          },
          "additionalProperties": false,
          "required": [
            "intent"
          ]
        }
      ]
    },
    "Grammar": {
      "type": "object",
      "properties": {
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Example"
          }
        },
        "exercise_answer": {
          "type": "string",
          "default": ""
        },
        "exercise_prompt": {
          "type": "string",
          "default": ""
        },
        "formation": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "recognition_prompt": {
          "type": "string"
        },
        "usage": {
          "type": "string",
          "default": ""
        },
        "use_key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "pattern",
        "use_key",
        "meaning",
        "formation",
        "recognition_prompt",
        "examples"
      ]
