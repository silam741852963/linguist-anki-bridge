        "provider": {
          "type": "string"
        },
        "readings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_entries": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "senses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sense"
          }
        },
        "source_url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "source_url",
        "language",
        "forms",
        "readings",
        "senses"
