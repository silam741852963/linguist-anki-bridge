      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "target_language",
        "explanation_language",
        "content",
        "requested_tasks"
      ]
    },
    "ManagedModel": {
      "type": "object",
      "properties": {
        "css": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "templates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Template"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "fields",
        "templates",
        "css"
      ]
