      "type": "object",
      "properties": {
        "deck_id": {
          "$ref": "#/$defs/AnkiId"
        },
        "history_digest": {
          "type": "string"
        },
        "home_deck_id": {
          "$ref": "#/$defs/AnkiId"
        },
        "id": {
          "$ref": "#/$defs/AnkiId"
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "task": {
          "$ref": "#/$defs/Task"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "task",
        "deck_id",
        "home_deck_id",
        "scheduler",
        "history_digest"
      ]
