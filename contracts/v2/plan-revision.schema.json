          "default": {}
        },
        "evidence": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "explanation_language": {
          "$ref": "#/$defs/Language"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "issues": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "media": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MediaAsset"
          }
        },
        "personal_notes": {
          "type": "string",
          "default": ""
        },
        "regions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRegion"
          }
        },
        "requested_tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "reviews": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ReviewDecision"
          }
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 2,
          "minimum": 2
        },
        "source_summary": {
          "type": "string",
          "default": ""
        },
        "sources": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRecord"
          }
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "target_language": {
          "$ref": "#/$defs/Language"
        }
