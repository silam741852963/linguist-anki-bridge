          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "anchor"
            },
            "value": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
