        "filename": {
          "type": "string"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime": {
          "type": "string"
        },
        "original_filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "$ref": "#/$defs/MediaOwner"
        },
        "role": {
          "$ref": "#/$defs/MediaRole"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "filename",
        "size_bytes",
        "mime",
        "owner",
        "role",
        "attribution"
      ]
    },
    "MediaOwner": {
      "type": "string",
      "enum": [
        "source",
        "app",
        "external"
      ]
    },
    "MediaRole": {
      "type": "string",
      "enum": [
        "picture",
        "audio",
        "archive"
      ]
    },
    "Provenance": {
      "type": "string",
      "enum": [
        "source",
        "dictionary",
        "ocr",
        "generated",
        "user"
      ]
    },
    "RenderedNote": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "media_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "$ref": "#/$defs/ManagedModel"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "document_id",
        "model",
        "fields",
        "tasks",
        "media_digests",
        "digest"
      ]
    },
    "ResolvedSettings": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resource_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secret_refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": true
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "values",
        "provenance",
        "resource_hashes",
        "secret_refs",
        "fingerprint"
      ]
    },
    "ReviewChoice": {
      "oneOf": [
        {
          "type": "object",
