{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SplitRequest",
  "type": "object",
  "properties": {
    "actor": {
      "type": "string"
    },
    "anchor_index": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "base_digest": {
      "type": "string"
    },
    "base_revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_digest": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Grammar"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_revision",
    "base_digest",
    "document_id",
    "input_digest",
    "actor",
    "anchor_index",
    "units"
  ],
  "$defs": {
    "Contrast": {
      "type": "object",
      "properties": {
        "difference": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "expression",
        "difference"
      ]
    },
    "Example": {
      "type": "object",
      "properties": {
        "evidence_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "sentence": {
          "type": "string"
        },
        "translation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sentence",
        "translation",
        "provenance"
      ]
    },
    "Grammar": {
      "type": "object",
      "properties": {
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Example"
          }
        },
        "exercise_answer": {
          "type": "string",
          "default": ""
        },
        "exercise_prompt": {
          "type": "string",
          "default": ""
        },
        "formation": {
          "type": "string"
        },
        "forms": {
          "description": "v3: the forms the pattern takes in sentences (e.g. \"に加えて\", \"に加え\"),\nused to highlight it; empty uses forms derived from the pattern.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jlpt": {
          "description": "v3: JLPT level (\"n2\") and lesson (\"minna-42\"), rendered as tags.",
          "type": "string"
        },
        "lesson": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        },
        "nuance": {
          "description": "v3: contrasts with similar patterns (a source's \"[Chú ý]\" notes).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contrast"
          }
        },
        "pattern": {
          "type": "string"
        },
        "recognition_prompt": {
          "type": "string"
        },
        "source_meaning": {
          "description": "v3: the source's own meaning line, verbatim in the source's language\n(e.g. the Vietnamese gloss of a Minna no Nihongo page), shown under\nthe meaning written in the explanation language.",
          "type": "string"
        },
        "usage": {
          "type": "string",
          "default": ""
        },
        "use_key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "pattern",
        "use_key",
        "meaning",
        "formation",
        "recognition_prompt",
        "examples"
      ]
    },
    "Provenance": {
      "type": "string",
      "enum": [
        "source",
        "dictionary",
        "ocr",
        "generated",
        "user",
        "provider"
      ]
    }
  }
}
