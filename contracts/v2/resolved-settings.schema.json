{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResolvedSettings",
  "type": "object",
  "properties": {
    "fingerprint": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resource_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "secret_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": true
    },
    "version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "values",
    "provenance",
    "resource_hashes",
    "secret_refs",
    "fingerprint"
  ]
}
