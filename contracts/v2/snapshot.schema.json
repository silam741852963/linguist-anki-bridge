{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot",
  "type": "object",
  "properties": {
    "archives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceArchive"
      }
    },
    "before_digest": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MediaAsset"
      }
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "originals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceRecord"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "operation_id",
    "originals",
    "archives",
    "media",
    "before_digest"
  ],
  "$defs": {
    "AnkiId": {
      "description": "Canonical positive decimal Anki ID, at most 9007199254740991",
      "type": "string",
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)$"
    },
    "CardState": {
      "type": "object",
      "properties": {
        "deck_id": {
          "$ref": "#/$defs/AnkiId"
        },
        "history_digest": {
          "type": "string"
        },
        "home_deck_id": {
          "$ref": "#/$defs/AnkiId"
        },
        "id": {
          "$ref": "#/$defs/AnkiId"
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "task": {
          "$ref": "#/$defs/Task"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "task",
        "deck_id",
        "home_deck_id",
        "scheduler",
        "history_digest"
      ]
    },
    "MediaAsset": {
      "type": "object",
      "properties": {
        "attribution": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime": {
          "type": "string"
        },
        "original_filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "$ref": "#/$defs/MediaOwner"
        },
        "role": {
          "$ref": "#/$defs/MediaRole"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "filename",
        "size_bytes",
        "mime",
        "owner",
        "role",
        "attribution"
      ]
    },
    "MediaOwner": {
      "type": "string",
      "enum": [
        "source",
        "app",
        "external"
      ]
    },
    "MediaRole": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "picture",
            "audio",
            "archive"
          ]
        },
        {
          "description": "Animated stroke-order image for one kanji (v3 Kanji field).",
          "type": "string",
          "const": "kanji_stroke"
        }
      ]
    },
    "SourceArchive": {
      "type": "object",
      "properties": {
        "asset_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "original_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "original_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "digest",
        "original_fields",
        "asset_digests"
      ]
    },
    "SourceRecord": {
      "type": "object",
      "properties": {
        "captured_at_unix_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardState"
          }
        },
        "digest": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "media_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_manifest": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template_manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "location",
        "digest",
        "fields",
        "model_manifest",
        "tags",
        "cards",
        "media_refs"
      ]
    },
    "Task": {
      "type": "string",
      "enum": [
        "comprehension",
        "production",
        "spelling",
        "recognition",
        "application"
      ]
    }
  }
}
