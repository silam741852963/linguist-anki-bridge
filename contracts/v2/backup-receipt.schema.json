{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BackupReceipt",
  "type": "object",
  "properties": {
    "binding": {
      "$ref": "#/$defs/CollectionBinding"
    },
    "checksum": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "includes_media": {
      "type": "boolean"
    },
    "includes_scheduling": {
      "type": "boolean"
    },
    "includes_schema": {
      "type": "boolean"
    },
    "path": {
      "type": "string"
    },
    "restoration_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope_digest": {
      "type": "string"
    },
    "verification_digest": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "binding",
    "path",
    "checksum",
    "scope_digest",
    "includes_scheduling",
    "includes_media",
    "includes_schema",
    "verification_digest"
  ],
  "$defs": {
    "CollectionBinding": {
      "type": "object",
      "properties": {
        "bridge_id": {
          "type": "string",
          "format": "uuid"
        },
        "capability_digest": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "lineage_id": {
          "type": "string",
          "format": "uuid"
        },
        "path_fingerprint": {
          "type": "string"
        },
        "profile_fingerprint": {
          "type": "string"
        },
        "session_epoch": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "profile_fingerprint",
        "path_fingerprint",
        "bridge_id",
        "lineage_id",
        "session_epoch",
        "capability_digest"
      ]
    }
  }
}
