{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResolutionRequest",
  "type": "object",
  "properties": {
    "actor": {
      "type": "string"
    },
    "base_digest": {
      "type": "string"
    },
    "base_revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "choice": {
      "$ref": "#/$defs/ReviewChoice"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_digest": {
      "type": "string"
    },
    "issue_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 2,
      "minimum": 2
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_revision",
    "base_digest",
    "document_id",
    "issue_id",
    "input_digest",
    "actor",
    "choice"
  ],
  "$defs": {
    "AnkiId": {
      "description": "Canonical positive decimal Anki ID, at most 9007199254740991",
      "type": "string",
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)$"
    },
    "MediaRole": {
      "type": "string",
      "enum": [
        "picture",
        "audio",
        "archive"
      ]
    },
    "ReviewChoice": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "sense"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "sense_with_reading"
            },
            "value": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "reading": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "key",
                "reading"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "anchor"
            },
            "value": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "segmentation"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "duplicate"
            },
            "value": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "note_id": {
                  "$ref": "#/$defs/AnkiId"
                }
              },
              "additionalProperties": false,
              "required": [
                "note_id",
                "action"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "media"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "cue"
            },
            "value": {
              "type": "object",
              "properties": {
                "task": {
                  "$ref": "#/$defs/Task"
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "task",
                "text"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "exercise"
            },
            "value": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "prompt",
                "answer"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "content_verified"
            },
            "value": {
              "type": "object",
              "properties": {
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "evidence_ids"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "source_content_verified"
            },
            "value": {
              "type": "object",
              "properties": {
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "source_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "additionalProperties": false,
              "required": [
                "source_id",
                "evidence_ids"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "source_media_role"
            },
            "value": {
              "type": "object",
              "properties": {
                "asset_digest": {
                  "type": "string"
                },
                "attribution": {
                  "type": "string"
                },
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "license": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "original_filename": {
                  "type": "string"
                },
                "role": {
                  "$ref": "#/$defs/MediaRole"
                },
                "source_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "additionalProperties": false,
              "required": [
                "source_id",
                "asset_digest",
                "original_filename",
                "evidence_id",
                "role",
                "attribution"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "value"
          ]
        }
      ]
    },
    "Task": {
      "type": "string",
      "enum": [
        "comprehension",
        "production",
        "spelling",
        "recognition",
        "application"
      ]
    }
  }
}
