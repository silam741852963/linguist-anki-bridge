# Anki Settings
ANKI_CONNECT_URL=http://localhost:8765
DEFAULT_DECK=Default
DEFAULT_NOTE_TYPE=Basic

# LLM Provider: "vllm" or "gemini"
LLM_PROVIDER=vllm

# vLLM Configuration
# The tool expects a running vLLM server with an OpenAI-compatible API
VLLM_API_BASE=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3-8b-instruct

# Gemini Configuration (if using gemini provider)
# GEMINI_API_KEY=your_api_key_here
